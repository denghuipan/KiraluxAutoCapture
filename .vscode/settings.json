{
  "python.defaultInterpreterPath": "${env:USERPROFILE}\\anaconda3\\envs\\DNN\\python.exe",
  "python.terminal.activateEnvironment": true,
  "python.condaPath": "${env:USERPROFILE}\\anaconda3\\Scripts\\conda.exe",
  "terminal.integrated.profiles.windows": {
    "PowerShell (conda hook + DNN)": {
      "source": "PowerShell",
      "icon": "terminal-powershell",
      "args": [
        "-NoExit",
        "-Command",
        "& \"$env:USERPROFILE\\anaconda3\\Scripts\\conda.exe\" \"shell.powershell\" \"hook\" | Out-String | Invoke-Expression; conda activate DNN"
      ]
    }
  },
  "terminal.integrated.defaultProfile.windows": "PowerShell (conda hook + DNN)",
  "specstory.cloudSync.enabled": "never"
}
